# Public, build-time configuration. Every NEXT_PUBLIC_* value is exposed in the
# browser bundle and must never contain a secret.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key

# Server-only. The Supabase secret key has elevated access and bypasses RLS.
# Never prefix it with NEXT_PUBLIC_, import it from a Client Component, log it,
# or commit a real value. Use only in narrowly scoped, authorized server code.
SUPABASE_SECRET_KEY=replace-with-your-secret-key

# Server-only HMAC key used to derive domain-separated, non-reversible visitor
# and like identifiers. Generate at least 32 cryptographically random bytes;
# for example: openssl rand -base64 48
VISITOR_HMAC_SECRET=replace-with-at-least-32-random-bytes
